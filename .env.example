# ============================================================
# VEREDICTO · INTELIGENCIA DEPORTIVA — Variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# .env.local NUNCA se commitea. En producción viven en Vercel.
# ============================================================

# ─── Supabase ────────────────────────────────────────────────
# Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key   # SOLO servidor — jamás en cliente

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Veredicto · Inteligencia Deportiva"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Competición histórica del Mundial ───────────────────────
NEXT_PUBLIC_COMPETITION_ID=a1b2c3d4-e5f6-7890-abcd-ef1234567890


# ════════════════════════════════════════════════════════════
# CLAVES DE PROVEEDORES DEPORTIVOS
#
# Ninguna de estas variables lleva el prefijo NEXT_PUBLIC_ y ninguna
# debe llevarlo: todas se leen exclusivamente en el servidor. Una clave
# con ese prefijo acaba en el bundle del navegador.
#
# Qué proveedor cubre qué módulo: docs/API_ARCHITECTURE.md
# ════════════════════════════════════════════════════════════

# ─── FÚTBOL · API-Football (api-sports.io) ───────────────────
# Fuente principal de fútbol: la única que da plantillas, lesiones,
# alineaciones y estadísticas por jugador. Plan Pro = 7.500 req/día.
FOOTBALL_API_KEY=tu-clave-de-api-football
# Compatibilidad: el código lee SPORTS_API_KEY. Mientras no se renombre
# en Vercel, esta es la que manda y FOOTBALL_API_KEY queda documentada
# como el nombre al que migrar.
SPORTS_API_KEY=tu-clave-de-api-football
FOOTBALL_API_URL=v3.football.api-sports.io
SPORTS_API_HOST=v3.football.api-sports.io
# Año de INICIO de la campaña europea (2026 = temporada 2026-27).
FOOTBALL_API_SEASON=2026

# ─── BALONCESTO · api-basketball (opcional, hoy sin usar) ────
# La cuenta sigue en plan Free en baloncesto (100 req/día, sin
# temporada en curso), así que la NBA se sirve desde ESPN. Estas
# variables quedan listas para el día que se contrate.
# BASKETBALL_API_KEY=
# BASKETBALL_API_URL=v1.basketball.api-sports.io
NBA_API_SEASON=2026

# ─── TENIS ───────────────────────────────────────────────────
# El circuito actual (ranking, torneos, partidos) se sirve desde ESPN,
# que no pide clave. El histórico profundo para backtesting viene de
# los CSV públicos de Jeff Sackmann. No hay nada que configurar.
# TENNIS_API_KEY=
# TENNIS_API_URL=

# ─── CUOTAS · The Odds API ───────────────────────────────────
# OJO: esta API manda la clave en el QUERY STRING, no en cabecera.
# Cualquier log de la URL la filtraría; por eso el cliente la redacta.
ODDS_API_KEY=tu-clave-de-the-odds-api
ODDS_API_URL=https://api.the-odds-api.com/v4
ODDS_API_SPORT=soccer_epl

# ─── NOTICIAS · ESPN ─────────────────────────────────────────
# Sin clave. Feed por liga y por circuito.
# SPORTS_NEWS_API_KEY=

# ─── ESPN (fútbol de respaldo, NBA, tenis, noticias) ─────────
# Sin clave ni cuota declarada. No hay variables que configurar.


# ════════════════════════════════════════════════════════════
# SELECCIÓN DE PROVEEDOR POR MÓDULO (opcional)
#
# Cadena en orden de preferencia, separada por comas. Si se omite,
# se usa el orden por defecto que está entre paréntesis. Un nombre
# desconocido se ignora y cae al defecto: una env mal escrita no
# tumba el arranque.
# ════════════════════════════════════════════════════════════

# FOOTBALL_PROVIDER=api-football,espn     (por defecto)
# BASKETBALL_PROVIDER=espn                (por defecto)
# TENNIS_PROVIDER=espn                    (por defecto)
# ODDS_PROVIDER=the-odds-api              (por defecto)
# NEWS_PROVIDER=espn                      (por defecto)


# ─── Cron ────────────────────────────────────────────────────
# Protege las rutas /api/sync/*. Vercel Cron lo envía como
# `Authorization: Bearer <CRON_SECRET>`. Genera uno largo y aleatorio.
CRON_SECRET=genera-un-secreto-aleatorio-largo

# ─── IA (análisis de partido) ────────────────────────────────
# ANTHROPIC_API_KEY=
